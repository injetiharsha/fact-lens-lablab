# Optional partner API keys. The app requires real cited evidence for verdicts.
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
SPEECHMATICS_API_KEY=

# Optional fallback search provider. DuckDuckGo is tried first.
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_WIKIPEDIA_ONLY=0

# Optional model used by Gemini evidence helper.
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GEMINI_INTAKE_MODEL=gemini-2.5-flash
GEMINI_MODERATOR_MODEL=gemini-2.5-flash

# Featherless is used by the Skeptic Agent when configured.
FEATHERLESS_API_BASE=https://api.featherless.ai/v1/chat/completions
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Runtime mesh controls
MODEL_POLICY=quality
FACTLENS_MIN_EVIDENCE_COUNT=4
FACTLENS_MIN_TRUSTED_SOURCES=2
FACTLENS_MIN_DOMAIN_DIVERSITY=3
FACTLENS_STAGE_TIMEOUT_SEC=15
FACTLENS_VERIFIER_TRIGGER_CONFIDENCE_GATE=65
FACTLENS_DOMAIN_BLACKLIST=

# Local UI demo only. Leave off for real judging runs.
FACTLENS_ALLOW_OFFLINE_FALLBACK=0

# Memory + cache controls
FACTLENS_MEMORY_DB=./data/factlens_memory.sqlite3
CACHE_MODE=off
CACHE_TTL_SECONDS=86400
FACTLENS_SESSION_ID=
FACTLENS_POLICY_VERSION=v1
FEATHERLESS_SKEPTIC_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
FEATHERLESS_MODERATOR_HEAVY_MODEL=openai/gpt-oss-120b
FACTLENS_MODERATOR_HEAVY_ENABLE=1
